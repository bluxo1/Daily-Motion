# Runtime role must be non-owner, NOBYPASSRLS; migrations use separate credentials.
DM_ENVIRONMENT=production
DM_DATABASE_URL=postgresql+psycopg://dm_runtime:replace-me@127.0.0.1:25432/daily_motion
DM_SUPABASE_URL=https://replace-me.supabase.co
DM_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DM_JWT_ISSUER=https://replace-me.supabase.co/auth/v1
DM_JWT_AUDIENCE=authenticated
DM_SYNC_SIGNING_KEY=replace-with-at-least-32-random-characters
# Only with DM_ENVIRONMENT=development or test; staging/production reject it.
# Optional synthetic issuer PUBLIC key; never a private signing key.
# DM_JWT_PUBLIC_KEY_FILE=/absolute/path/to/public.pem
